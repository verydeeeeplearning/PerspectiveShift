# === PerspectiveShift Environment Variables ===
# Copy this file to .env.local and fill in real values
# NEVER commit .env.local to the repository

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# --- LangSmith ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=perspectiveshift

# --- OAuth (configured in Supabase Dashboard) ---
# Google, Kakao, Apple OAuth are configured via Supabase Auth dashboard
# No additional env vars needed here

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
